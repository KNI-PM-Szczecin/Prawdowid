# Skopiuj do .env i uzupełnij. Nie commituj .env.
# Dostawca modelu językowego (wymienny, patrz agent/)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Baza danych (Supabase = zwykły PostgreSQL). Wspólna dla backend/ i rag/.
# Supabase: Project Settings > Database > Connection string > Session pooler (port 5432, adres *.pooler.supabase.com).
# Nie używaj Direct connection (db.<ref>.supabase.co, tylko IPv6, nie działa z Dockera)
# ani Transaction pooler (port 6543, psuje prepared statements w pgx i asyncpg).
# Przykład: postgresql://postgres.<ref>:<haslo>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
# Puste = lokalny Postgres z rag/docker-compose.yml (profil local-db): postgresql://rag:rag@localhost:5432/rag
DATABASE_URL=
# Limit połączeń na serwis (darmowy Supabase ma mały limit puli).
DATABASE_MAX_CONNS=5
RAG_POSTGRES_POOL_MAX_SIZE=5

# Backend
PORT=3001

# Kanał dodatkowy (np. Discord)
DISCORD_BOT_TOKEN=

# Serwis rag/ (Python)
RAG_URL=http://localhost:8001
# Opcjonalnie: endpoint zgodny z OpenAI (np. FastFlowLM) do ekspansji zapytań. Puste = reguły.
RAG_EXPANSION_LLM_URL=
RAG_EXPANSION_LLM_MODEL=qwen3.5:9b
