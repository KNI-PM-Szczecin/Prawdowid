# Skopiuj do .env i uzupełnij. Nie commituj .env.

# Dostawca modelu językowego (wymienny, patrz agent/). Serwer zgodny z OpenAI /v1/chat/completions.
# Wariant 1 (hostowany OpenAI): LLM_BASE_URL=https://api.openai.com/v1, LLM_MODEL=gpt-6-luna (tani, 0,10/0,50 USD za 1M tokenów)
#   albo gpt-6-sol (2/10 USD). Dla api.openai.com agent sam pomija temperature/max_tokens i wysyła max_completion_tokens
#   oraz reasoning_effort. Klucz wpisz tylko w .env lub Railway variables, nigdy w repo ani na czacie.
#   LLM_REASONING_EFFORT: domyślnie "none" (działa na gpt-6-luna i gpt-6-sol); dla gpt-6.1-sol i gpt-6-astra ustaw "low".
# Wariant 2 (lokalny FastFlowLM): LLM_BASE_URL=http://<ip>:52625/v1, LLM_API_KEY puste, LLM_MODEL=qwen3:0.6b.
# LLM_PROVIDER jest informacyjny: agent obsługuje dziś tylko serwery zgodne z OpenAI i tej zmiennej nie czyta.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=none
# Ceny do meta.estimatedCostUsd w USD za 1M tokenów. Domyślne dla gpt-6-luna (stan z 21.11.2026).
# Dla lokalnego serwera agent ustawia 0, niezależnie od tych wartości.
LLM_PRICE_INPUT_PER_M=0.10
LLM_PRICE_OUTPUT_PER_M=0.50
# Limit czasu jednego wywołania rag/ w sekundach (CONTRACT.md §2: 30 s; całe Verify ma 45 s).
RAG_TIMEOUT_SECONDS=30

# Baza danych: PostgreSQL z rozszerzeniem pgvector (Supabase ma je wbudowane). Wektory korpusu leżą w tej samej bazie
# co metadane, więc lokalny rag/ na bazie produkcji pisałby do produkcyjnego korpusu: lokalnie zostaw DATABASE_URL puste
# i użyj profilu local-db.
# Supabase > Project Settings > Database > Connection string > Session pooler (port 5432, *.pooler.supabase.com).
# Wstaw hasło bazy i dopisz ?sslmode=require. Projekt zakładaj w regionie UE (np. eu-central-1).
# Nie używaj Direct connection (tylko IPv6, nie działa z Dockera) ani Transaction pooler (port 6543).
# Wzór: postgresql://postgres.<project-ref>:<haslo-bazy>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
# Limit połączeń na serwis; darmowy Supabase ma małą pulę, a łączą się dwa serwisy.
DATABASE_MAX_CONNS=5
RAG_POSTGRES_POOL_MAX_SIZE=5

# Backend
PORT=3001
# Limit sprawdzeń na minutę na adres klienta i retencja zapisanych przebiegów (dni)
CHECK_RATE_LIMIT_PER_MINUTE=60
CHECK_RETENTION_DAYS=30
# Jak długo to samo pytanie dostaje zapamiętany wynik (spójność między odświeżeniami i kanałami), w minutach.
# 0 wyłącza. Nagłówek Cache-Control: no-cache na POST /api/check liczy wynik od nowa.
CHECK_RESULT_CACHE_MINUTES=30
# Po ilu dniach najnowsze źródło oznaczamy jako materiał archiwalny
BADGE_ARCHIVAL_DAYS=365
# Ile proxy dopisuje wpis do X-Forwarded-For przed backendem (limit żądań czyta wpis liczony od prawej).
# Uwaga: bez proxy przed backendem klient może sam wpisać ten nagłówek i obejść limit.
TRUSTED_PROXY_HOPS=1

# Pętla informacji (CONTRACT.md §1a, cases). Próg podobnych pytań bez źródeł, po którym sprawa jest rekomendowana analitykowi.
MODERATOR_REPEAT_THRESHOLD=3
# Opcjonalny webhook https (np. kanał Discord moderatorów). Pusty: sprawy są tylko rekomendowane, nigdy „przekazane”.
# Treść zamaskowanego twierdzenia trafia do dostawcy webhooka (Discord: poza EOG).
MODERATOR_WEBHOOK_URL=
# Token do GET /api/admin/cases (lista spraw dla analityka). Pusty: lista zamknięta.
MODERATOR_TOKEN=

# Serwis rag/ (Python)
RAG_URL=http://localhost:8001
# Wymagane w trybie lokalnej bazy (--profile local-db) w docker-compose.yml w korzeniu i w rag/. Wygeneruj np.:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_POSTGRES_PASSWORD=
# Token do endpointów administracyjnych rag/ (POST /ingest, POST i DELETE /incidents, DELETE /sources/{id}, POST /admin/*),
# nagłówek X-Admin-Token. Pusty = wszystkie te endpointy wyłączone, korpusu nie da się zasilić.
RAG_ADMIN_TOKEN=
# Opcjonalnie: endpoint zgodny z OpenAI (np. FastFlowLM albo api.openai.com) do ekspansji zapytań. Puste = reguły.
# OpenAI: RAG_EXPANSION_LLM_URL=https://api.openai.com/v1, RAG_EXPANSION_LLM_MODEL=gpt-6-luna,
# RAG_EXPANSION_LLM_API_KEY=<klucz>, RAG_EXPANSION_LLM_REASONING_EFFORT=none.
# Dla api.openai.com rag wysyła temperature 0 tylko przy reasoning_effort=none; przy innym wysiłku używa reguł.
RAG_EXPANSION_LLM_URL=
RAG_EXPANSION_LLM_MODEL=qwen3:0.6b
RAG_EXPANSION_LLM_API_KEY=
RAG_EXPANSION_LLM_REASONING_EFFORT=none
RAG_EXPANSION_CACHE_TTL_SECONDS=3600

# Startowy korpus demo i katalog kampanii (app/data/seed_*.json). 0 wyłącza automatyczne uzupełnianie.
RAG_SEED_CORPUS_ENABLED=true
RAG_SEED_INCIDENTS_ENABLED=true

# Odyseusz MSZ (publiczne API JSON odyseusz.gov.pl): komunikaty dla podróżnych, jeden dokument na państwo.
# Odświeżane co godzinę i pobierane na żądanie, gdy twierdzenie wymienia państwo. false wyłącza.
RAG_ODYSEUSZ_ENABLED=true
# Pierwszy pełny import rusza po tylu minutach od startu (nie konkuruje o CPU z pierwszymi sprawdzeniami po deployu).
# Do tego czasu kraj wymieniony w twierdzeniu jest pobierany na żądanie. POST /admin/corpus/odyseusz uruchamia import od razu.
RAG_ODYSEUSZ_FIRST_RUN_DELAY_MINUTES=45

# Wikidata: dane o osobach z twierdzenia (opis, data urodzenia i śmierci), publiczne API bez klucza, licencja CC0.
# Do Wikimedia Foundation (poza EOG) trafiają tylko nazwy pisane wielką literą. false wyłącza.
RAG_WIKIDATA_ENABLED=true

# Google Fact Check Tools API (klucz z Google Cloud, nigdy w repo). Używa go rag/ przy wyszukiwaniu
# i eval/prawdowid_benchmark przy budowie zbioru benchmarku.
FACTCHECK_API_KEY=

# Sędzia LLM benchmarku (eval/BENCHMARK.md): Claude przez Anthropic API, inny dostawca niż model systemu.
# Klucz z console.anthropic.com, tylko w .env. JUDGE_MODEL domyślnie claude-opus-5-5.
ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-opus-5-5

# EUvsDisinfo (token od mentora, funkcja premiowana)
EUVSDISINFO_TOKEN=

# Bot Discord (drugi kanał, src/backend/discord.go): komenda slash /factcheck w bocie,
# łączy się przez Gateway w procesie backendu.
DISCORD_BOT_TOKEN=
# Identyfikator serwera testowego (guild) — komenda /factcheck rejestruje się wtedy od razu na tym serwerze.
# Puste = rejestracja globalna (może zająć do godziny). Wymagane uprawnienia bota: applications.commands
# i Add Reactions. Odczyt treści wiadomości (Message Content Intent) nie jest potrzebny przy slash commands.
DISCORD_GUILD_ID=
# Identyfikator aplikacji i klucz publiczny z Developer Portal: w trybie Gateway nieużywane,
# przydadzą się tylko przy ewentualnym przejściu na endpoint HTTP interactions (webhook).
