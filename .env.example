# Skopiuj do .env i uzupełnij. Nie commituj .env.

# Dostawca modelu językowego (wymienny, patrz agent/). Serwer zgodny z OpenAI /v1/chat/completions.
# Wariant 1 (hostowany OpenAI): LLM_BASE_URL=https://api.openai.com/v1, LLM_MODEL=gpt-6-luna (tani, 0,10/0,50 USD za 1M tokenów)
#   albo gpt-6-sol (2/10 USD). Dla api.openai.com agent sam pomija temperature/max_tokens i wysyła max_completion_tokens
#   oraz reasoning_effort. Klucz wpisz tylko w .env lub Railway variables, nigdy w repo ani na czacie.
#   LLM_REASONING_EFFORT: domyślnie "none" (działa na gpt-6-luna i gpt-6-sol); dla gpt-6.1-sol i gpt-6-astra ustaw "low".
# Wariant 2 (lokalny FastFlowLM): LLM_BASE_URL=http://<ip>:52625/v1, LLM_API_KEY puste, LLM_MODEL=qwen3:0.6b.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=none
# Ceny do meta.estimatedCostUsd w USD za 1M tokenów. Domyślne dla gpt-6-luna (stan z 21.11.2026).
# Dla lokalnego serwera agent ustawia 0, niezależnie od tych wartości.
LLM_PRICE_INPUT_PER_M=0.10
LLM_PRICE_OUTPUT_PER_M=0.50

# Baza danych: PostgreSQL w Supabase, jedna dla backend/ i rag/.
# Supabase > Project Settings > Database > Connection string > Session pooler (port 5432, *.pooler.supabase.com).
# Wstaw hasło bazy i dopisz ?sslmode=require. Projekt zakładaj w regionie UE (np. eu-central-1).
# Nie używaj Direct connection (tylko IPv6, nie działa z Dockera) ani Transaction pooler (port 6543).
# Wzór: postgresql://postgres.<project-ref>:<haslo-bazy>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
# Limit połączeń na serwis; darmowy Supabase ma małą pulę, a łączą się dwa serwisy.
DATABASE_MAX_CONNS=5
RAG_POSTGRES_POOL_MAX_SIZE=5

# Backend
PORT=3001
# Limit sprawdzeń na minutę na adres klienta i retencja zapisanych przebiegów (dni)
CHECK_RATE_LIMIT_PER_MINUTE=20
CHECK_RETENTION_DAYS=30
# Po ilu dniach najnowsze źródło oznaczamy jako materiał archiwalny
BADGE_ARCHIVAL_DAYS=365
# Ile proxy dopisuje wpis do X-Forwarded-For przed backendem (limit żądań czyta wpis liczony od prawej).
# Uwaga: bez proxy przed backendem klient może sam wpisać ten nagłówek i obejść limit.
TRUSTED_PROXY_HOPS=1

# Serwis rag/ (Python)
RAG_URL=http://localhost:8001
# Wymagane do docker compose w rag/. Wygeneruj np.: python -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_POSTGRES_PASSWORD=
# Token do POST /ingest, DELETE /sources/{id}, POST /admin/eviction (nagłówek X-Admin-Token). Pusty = te endpointy wyłączone.
RAG_ADMIN_TOKEN=
# Opcjonalnie: endpoint zgodny z OpenAI (np. FastFlowLM) do ekspansji zapytań. Puste = reguły.
# Ekspansja zapytań przez OpenAI: RAG_EXPANSION_LLM_URL=https://api.openai.com/v1, model gpt-6-luna (zmiana tylko w .env; rag/ nie był testowany z OpenAI).
RAG_EXPANSION_LLM_URL=
RAG_EXPANSION_LLM_MODEL=qwen3:0.6b
RAG_EXPANSION_LLM_API_KEY=

# Google Fact Check Tools API (klucz z Google Cloud, nigdy w repo)
FACTCHECK_API_KEY=

# EUvsDisinfo (token od mentora, funkcja premiowana)
EUVSDISINFO_TOKEN=

# Bot Discord (drugi kanał, token z Developer Portal, nigdy w repo)
DISCORD_BOT_TOKEN=
